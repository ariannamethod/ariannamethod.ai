def identity(stream):
    return stream
def advance(stream):
    return rng_uniform(stream)
first = rng_new(42)
bare = first
parenthesized = (first)
returned = identity(first)
assert(rng_uniform(first) == rng_uniform(bare), "bare copy")
assert(rng_uniform(parenthesized) == rng_uniform(returned), "expression copies")
assert(advance(first) == rng_uniform(bare), "parameter shares caller stream")
assert(advance(first) == rng_uniform(bare), "parameter advances caller")
assert(rng_uniform(parenthesized) == rng_uniform(returned), "copies remain independent")
assert(rng_index(first, 1) == 0, "singleton index")
assert(rng_uniform(bare) >= 0, "consume singleton peer draw")
assert(text_equal(list_key(map_keys(first)), list_key(map_keys(bare))), "state key order")
assert(map_get(first, "state0") == map_get(bare, "state0"), "singleton consumes draw")
assert(map_get(first, "state1") == map_get(bare, "state1"), "singleton consumes draw")
assert(map_get(first, "state2") == map_get(bare, "state2"), "singleton consumes draw")
assert(map_get(first, "state3") == map_get(bare, "state3"), "singleton consumes draw")
weights = [0, 1, 0]
assert(categorical_at(weights, 1, 0) == 1, "zero weights at left edge")
assert(categorical_at(weights, 1, 0.99999994) == 1, "zero weights at right edge")
weights = [1, 3]
assert(categorical_at(weights, 1, 0.24999999) == 0, "below CDF boundary")
assert(categorical_at(weights, 1, 0.25) == 1, "strict CDF boundary")
assert(categorical_at(weights, 0.5, 0.05) == 0, "temperature square left")
assert(categorical_at(weights, 0.5, 0.25) == 1, "temperature square right")
assert(categorical_at(weights, 0.000001, 0) == 1, "cold stable maximum")
extreme = [1e-38, 3e38]
assert(categorical_at(extreme, 0.000001, 0.99999994) == 1, "extreme finite weights")
assert(categorical_at(extreme, 3e38, 0.25) == 0, "hot weights approach uniform")
assert(categorical_at(extreme, 3e38, 0.75) == 1, "hot weights second half")
first = rng_new(42)
bare = first
assert(rng_categorical(first, [0, 1, 0], 1) == 1, "native categorical")
assert(rng_uniform(bare) >= 0, "consume categorical peer draw")
assert(rng_uniform(first) == rng_uniform(bare), "categorical advances exactly once")
assert(weights[0] == 1, "weights unchanged")
assert(weights[1] == 3, "weights unchanged")
PRINT "AML_SAMPLING_VECTORS_OK"
