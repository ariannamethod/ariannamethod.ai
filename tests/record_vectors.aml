# Typed leaves, copy boundaries, deliberate organ mutations and record replacement.
def mutate_parts(parts, weights):
    list_push(parts, 'shared')
    map_set(weights, 'pulse', 2)
    return 1
def give_record(state):
    return state
state = record_new()
original_words = list_new()
list_push(original_words, 'rain')
original_weights = map_new()
map_set(original_weights, 'pulse', 1)
original_array = [1, 2, 3]
record_set(state, 'number', -0.25)
record_set(state, 'text', 'שלום 🌧')
record_set(state, 'array', original_array)
record_set(state, 'words', original_words)
record_set(state, 'weights', original_weights)
original_array[0] = 99
list_push(original_words, 'outside')
map_set(original_weights, 'pulse', 99)
saved_array = record_get(state, 'array')
assert(saved_array[0] == 1, 'record_set copies array')
assert(list_len(record_get(state, 'words')) == 1, 'record_set copies list')
assert(map_get(record_get(state, 'weights'), 'pulse') == 1, 'record_set copies map')
assert(record_get(state, 'number') == -0.25, 'scalar leaf')
assert(text_equal(record_get(state, 'text'), 'שלום 🌧'), 'text leaf')
assert(text_equal(record_kind(state, 'number'), 'float'), 'float kind')
assert(text_equal(record_kind(state, 'text'), 'string'), 'string kind')
assert(text_equal(record_kind(state, 'array'), 'array'), 'array kind')
assert(text_equal(record_kind(state, 'words'), 'list'), 'list kind')
assert(text_equal(record_kind(state, 'weights'), 'map'), 'map kind')
assert(record_has(state, 'absent') == 0, 'absent field')
assert(record_has(state, 'number') == 1, 'present field')
order = record_keys(state)
assert(text_equal(list_get(order, 0), 'number'), 'first insertion')
assert(text_equal(list_get(order, 4), 'weights'), 'last insertion')
list_set(order, 0, 'changed key list')
assert(record_has(state, 'number') == 1, 'keys result owns mutation')
record_set(state, 'number', 7)
assert(text_equal(list_get(record_keys(state), 0), 'number'), 'replacement preserves position')
mutate_parts(record_get(state, 'words'), record_get(state, 'weights'))
assert(list_len(record_get(state, 'words')) == 2, 'organ mutates retained list')
assert(map_get(record_get(state, 'weights'), 'pulse') == 2, 'organ mutates retained map')
assigned = state
returned = give_record(state)
parenthesized = (state)
cloned = record_clone(state)
record_set(assigned, 'number', 8)
list_push(record_get(returned, 'words'), 'only returned')
map_set(record_get(parenthesized, 'weights'), 'pulse', 3)
record_set(cloned, 'text', 'only clone')
assert(record_get(state, 'number') == 7, 'assignment owns scalar replacement')
assert(list_len(record_get(state, 'words')) == 2, 'returned record owns list')
assert(map_get(record_get(state, 'weights'), 'pulse') == 2, 'parenthesized record owns map')
assert(text_equal(record_get(state, 'text'), 'שלום 🌧'), 'cloned record owns text')
checked = record_new()
record_set(checked, 'fresh', 42)
record_set(checked, 'words', original_words)
record_replace(state, checked)
assert(record_has(state, 'number') == 0, 'replace removes old fields')
assert(record_get(state, 'fresh') == 42, 'replace publishes new fields')
record_set(checked, 'fresh', 9)
list_push(record_get(checked, 'words'), 'changed source')
assert(record_get(state, 'fresh') == 42, 'replace owns scalar')
assert(list_len(record_get(state, 'words')) == 2, 'replace deep-copies list')
record_replace(state, state)
assert(record_get(state, 'fresh') == 42, 'self replacement')
record_set(state, '', 'empty key')
assert(text_equal(record_get(state, ''), 'empty key'), 'empty field key')
pending = record_new()
record_set(pending, 'next', 11)
assert(record_swap(state, pending) == 1, 'swap succeeds')
assert(record_get(state, 'next') == 11, 'swap receives checked contents')
assert(record_get(pending, 'fresh') == 42, 'swap preserves old contents')
assert(record_swap(state, state) == 1, 'self swap succeeds')
assert(record_get(state, 'next') == 11, 'self swap keeps contents')

# Equality binds the complete ordered value, including bits hidden by rounding.
def same_records(left, right):
    return record_equal(left, right)
left = record_new()
assert(record_equal(left, record_new()) == 1, 'empty records')
record_set(left, 'scalar', 1)
record_set(left, 'text', 'שלום 🌧')
record_set(left, 'array', matrix_zeros(2, 3))
parts = list_new()
list_push(parts, '')
list_push(parts, 'é')
record_set(left, 'list', parts)
weights = map_new()
map_set(weights, 'first', 1)
map_set(weights, 'second', -0)
record_set(left, 'map', weights)
right = record_clone(left)
assert(same_records(left, right) == 1, 'equal independent owners through helper')
assert(RECORD_EQUAL(left, left) == 1, 'case insensitive self equality')
record_set(right, 'scalar', 1.00000011920928955078125)
assert(record_equal(left, right) == 0, 'scalar one ULP differs')
assert(record_get(left, 'scalar') == 1, 'comparison preserves input')
record_set(left, 'scalar', 0)
record_set(right, 'scalar', -0)
assert(record_equal(left, right) == 0, 'scalar signed zero differs')
record_set(right, 'scalar', 0)
assert(record_equal(left, right) == 1, 'scalar restored')
record_set(right, 'scalar', '0')
assert(record_equal(left, right) == 0, 'leaf kind differs')
right = record_clone(left)
record_set(right, 'extra', 0)
assert(record_equal(left, right) == 0, 'field count differs')
right = record_clone(left)
record_set(right, 'text', 'שלום ☀')
assert(record_equal(left, right) == 0, 'text bytes differ')
right = record_clone(left)
record_set(right, 'array', matrix_zeros(3, 2))
assert(record_equal(left, right) == 0, 'matrix shape differs')
record_set(right, 'array', zeros(6))
assert(record_equal(left, right) == 0, 'vector shape differs')
changed = matrix_zeros(2, 3)
changed[5] = -0
record_set(right, 'array', changed)
assert(record_equal(left, right) == 0, 'array signed zero differs')
changed[5] = 1
record_set(left, 'array', changed)
changed[5] = 1.00000011920928955078125
record_set(right, 'array', changed)
assert(record_equal(left, right) == 0, 'array one ULP differs')
right = record_clone(left)
list_set(record_get(right, 'list'), 0, 'é')
list_set(record_get(right, 'list'), 1, '')
assert(record_equal(left, right) == 0, 'list order differs')
right = record_clone(left)
map_set(record_get(right, 'map'), 'second', 0)
assert(record_equal(left, right) == 0, 'map signed zero differs')
right = record_clone(left)
map_set(record_get(right, 'map'), 'first', 1.00000011920928955078125)
assert(record_equal(left, right) == 0, 'map one ULP differs')
weights = map_new()
map_set(weights, 'second', -0)
map_set(weights, 'first', 1)
right = record_clone(left)
record_set(right, 'map', weights)
assert(record_equal(left, right) == 0, 'map insertion order differs')
left = record_new()
record_set(left, 'a', 1)
record_set(left, 'b', 2)
right = record_new()
record_set(right, 'b', 2)
record_set(right, 'a', 1)
assert(record_equal(left, right) == 0, 'record insertion order differs')
right = record_new()
record_set(right, 'a', 1)
record_set(right, 'c', 2)
assert(record_equal(left, right) == 0, 'record key bytes differ')
full = record_new()
field = 0
while field < 1024:
    record_set(full, text_fixed(field, 0), field)
    field = field + 1
assert(list_len(record_keys(full)) == 1024, 'full record capacity')
record_set(full, '1023', [1, 2])
expected_full = record_clone(full)
record_set(expected_full, '0', 99)
expected_array = record_get(expected_full, '1023')
expected_array[1] = 7
CHANNEL CREATE full_gate 1
SPAWN full_copy:
    CHANNEL READ full_gate go
    record_set(full, '0', 99)
    received_array = record_get(full, '1023')
    received_array[1] = 7
    return full
record_set(full, '1', 88)
CHANNEL WRITE full_gate 1
AWAIT full_copy INTO received
assert(record_equal(expected_full, received), 'full record worker result')
assert(record_get(full, '0') == 0 and record_get(full, '1') == 88, 'full record independent parent')
parent_array = record_get(full, '1023')
assert(parent_array[1] == 2, 'full record independent mutable leaf')
record_swap(full, received)
assert(record_equal(full, expected_full), 'full record publication')
assert(record_get(received, '1') == 88, 'publication retains previous owner')
PRINT 'AML_RECORD_VECTORS_OK'
