# Content hashes, a line journal and external processes; paths resolve from this file.
def argv2(program, argument):
    xs = list_new()
    list_push(xs, program)
    list_push(xs, argument)
    return xs
assert(text_equal(text_hash_sha256('abc'), 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'), 'NIST abc')
assert(text_equal(text_hash_sha256(''), 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'), 'NIST empty')
two = text_hash_sha256('abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq')
assert(text_equal(two, '248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1'), 'NIST two blocks')
assert(text_equal(text_hash_sha256('שלום 🌧'), 'bcc707f6258549a51b71f52a42763ea38d8ab3151a1a8ad114a58da75697cb97'), 'UTF-8 bytes')
assert(file_exists('journal.log') == 0, 'fresh journal')
assert(file_append_line('journal.log', 'first') == 1, 'first line synced')
assert(file_append_line('journal.log', 'second') == 1, 'second line synced')
journal = file_hash_sha256('journal.log')
assert(text_equal(journal, text_hash_sha256('first\nsecond\n')), 'file hash equals text hash')
assert(text_equal(journal, 'dbea9325179efe46ea2add94f7b6b745ca983fabb208dc6d34aa064623d7ee23'), 'journal oracle')
r = process_run(argv2('echo', 'hi'))
assert(record_get(r, 'status') == 0, 'echo status')
assert(text_equal(record_get(r, 'stdout'), 'hi\n'), 'echo stdout')
assert(text_equal(record_get(r, 'stderr'), ''), 'echo stderr')
f = list_new()
list_push(f, 'false')
assert(record_get(process_run(f), 'status') == 1, 'nonzero exit')
env = record_new()
record_set(env, 'AML_TRANSPORT_VECTOR', 'a;b c')
r = process_run(argv2('printenv', 'AML_TRANSPORT_VECTOR'), env)
assert(text_equal(record_get(r, 'stdout'), 'a;b c\n'), 'environment record')
p = argv2('printf', '[%s]')
list_push(p, 'a;b c')
r = process_run(p, record_new(), 10)
assert(text_equal(record_get(r, 'stdout'), '[a;b c]'), 'one argv entry')
r = process_run(argv2('sleep', '5'), record_new(), 0.25)
assert(record_get(r, 'status') == -256, 'timeout status')
PRINT 'AML_TRANSPORT_VECTORS_OK'
